# Public Vite client configuration for Passkeys on Testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_STELLAR_WALLET_WASM_HASH=

# Firebase admin auth uses firebase-applet-config.json for public config.
# Create Firebase Auth users manually, then add appAdministrators/{uid}
# in Firestore to unlock /admin real mode.
# Firebase is the primary pilot persistence path for actor applications.
# Supabase remains documented as fallback only.
TRUSTLEAF_AUTH_ISSUER=
TRUSTLEAF_AUTH_AUDIENCE=
TRUSTLEAF_AUTH_JWKS_URL=
TRUSTLEAF_AUTH_JWKS_ALGORITHMS=RS256,ES256
TRUSTLEAF_AUTH_JWKS_CACHE_TTL_SECONDS=300
# Server-only JSON, for example {"firebase-uid-or-token-subject":["admin"]}.
# Never expose this value through VITE_* or accept role/subject headers.
TRUSTLEAF_AUTH_SUBJECT_ALLOWLIST_JSON=
# Server-only synthetic fixture directory for local object-authorization tests.
# Shape: {"mode":"synthetic-fixture","actors":[],"receipts":[]}.
# Empty means protected object access fails closed. Never expose via VITE_*.
TRUSTLEAF_OBJECT_AUTH_FIXTURES_JSON=

# Supabase Auth remains fail-closed until a separately approved synthetic gate.
# Browser code accepts only the publishable key; never place secret/service-role
# keys in VITE_* variables. Operational roles come from private actor_bindings.
VITE_TRUSTLEAF_SUPABASE_AUTH_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Defindex ReFi Vault Integration
# Request DEFINDEX_API_KEY from the Defindex team (https://defindex.io)
# Default network is testnet with the public XLM vault (CCLV4H7WTLJQ7ATLHBBQV2WW3OINF3FOY5XZ7VPHZO7NH3D2ZS4GFSF6)
DEFINDEX_API_KEY=
DEFINDEX_NETWORK=testnet
DEFINDEX_VAULT_DEFAULT=CCLV4H7WTLJQ7ATLHBBQV2WW3OINF3FOY5XZ7VPHZO7NH3D2ZS4GFSF6
# Social fund wallet that receives the % split of deposits (defaults to STELLAR_ADMIN_ADDRESS)
DEFINDEX_SOCIAL_FUND_ADDRESS=

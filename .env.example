# Stellar Configuration
STELLAR_NETWORK=testnet
# Fail closed: route authentication/RBAC never authorizes submission by itself.
# Keep both false until a separately approved isolated synthetic-data ceremony.
TRUSTLEAF_ALLOW_TESTNET_MUTATIONS=false
TRUSTLEAF_TESTNET_SUBMIT_ENABLED=false
TRUSTLEAF_PILOT_RUNTIME=disabled
# Durable storage remains disconnected. memory-fixture is the only accepted
# local test mode; postgres fails closed unless every reviewed gate is present.
TRUSTLEAF_DURABLE_STORE_MODE=memory-fixture
TRUSTLEAF_RETENTION_DAYS=30
TRUSTLEAF_DATABASE_URL=
TRUSTLEAF_KMS_KEY_ID=
TRUSTLEAF_BACKUP_VERIFIED_AT=
# KMS/HSM references only; credentials and private key material stay in the provider.
TRUSTLEAF_KMS_PROVIDER=
TRUSTLEAF_KMS_KEY_ALIAS=
TRUSTLEAF_KMS_KEY_VERSION=
TRUSTLEAF_KMS_WORKLOAD_IDENTITY=
TRUSTLEAF_KMS_AUTH_REF=
TRUSTLEAF_KMS_ENABLED=false
TRUSTLEAF_KMS_EXPORT_DISABLED=true
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Receipt V1 read-only Testnet contract deployed by the reviewed synthetic smoke.

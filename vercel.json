{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "soroban/target/wasm32v1-none/release/*.wasm"
    }
  },
  "headers": [
    {
      "source": "/pilot/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/verify/:token",
      "has": [{ "type": "host", "value": "cannabis.trustleaf.org" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/demo/receipt-pilot",
      "has": [{ "type": "host", "value": "cannabis.trustleaf.org" }],
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/ficha-link-pilot", "destination": "/api/stellar/readiness?__trustleaf_route=ficha-link-pilot" },
    { "source": "/pilot/ficha", "destination": "/index.html" },
    { "source": "/pilot/migrar-cuenta", "destination": "/index.html" },
    { "source": "/pilot/recetas/:resourceRef", "destination": "/index.html" },
    { "source": "/api/cannabis-waitlist", "destination": "/api/stellar/readiness?__trustleaf_route=cannabis-waitlist" },
    { "source": "/verify/:token", "has": [{ "type": "host", "value": "cannabis.trustleaf.org" }], "destination": "/index.html" },
    { "source": "/demo/receipt-pilot", "has": [{ "type": "host", "value": "cannabis.trustleaf.org" }], "destination": "/index.html" },
    { "source": "/api/dispensary-onboarding", "destination": "/api/stellar/readiness?__trustleaf_route=dispensary-onboarding" },
    { "source": "/api/team-invitations", "destination": "/api/stellar/readiness?__trustleaf_route=team-invitations" },
    { "source": "/api/operations-pilot", "destination": "/api/stellar/readiness?__trustleaf_route=operations-pilot" },
    { "source": "/api/dispensary-commerce", "destination": "/api/stellar/readiness?__trustleaf_route=dispensary-commerce" },
    { "source": "/api/calendar-worker", "destination": "/api/stellar/readiness?__trustleaf_route=calendar-worker" },
    { "source": "/api/google-calendar/jobs", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-jobs" },
    { "source": "/api/google-calendar/setup", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-setup" },
    { "source": "/api/google-calendar/process", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-process" },
    { "source": "/api/google-calendar/start", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-start" },
    { "source": "/api/google-calendar/status", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-status" },
    { "source": "/api/google-calendar/callback", "destination": "/api/stellar/readiness?__trustleaf_route=google-calendar-callback" },
    {
      "source": "/api/stellar/contracts",
      "destination": "/api/stellar/readiness?__trustleaf_route=contracts"
    },
    {
      "source": "/api/stellar/derive-wallet",
      "destination": "/api/stellar/readiness?__trustleaf_route=derive-wallet"
    },
    {
      "source": "/api/stellar/faucet",
      "destination": "/api/stellar/readiness?__trustleaf_route=faucet"
    },
    {
      "source": "/api/auth/privy/session",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-session"
    },
    {
      "source": "/api/auth/privy/bootstrap-admin",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-bootstrap-admin"
    },
    {
      "source": "/api/auth/privy/enroll-actor",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-enroll-actor"
    },
    {
      "source": "/api/auth/privy/submit-test-application",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-submit-test-application"
    },
    {
      "source": "/api/agenda",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-agenda"
    },
    {
      "source": "/api/auth/privy/admin/actors",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-admin-actors"
    },
    {
      "source": "/api/auth/privy/admin/pending-actors",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-admin-pending-actors"
    },
    {
      "source": "/api/auth/privy/admin/review-actor",
      "destination": "/api/stellar/readiness?__trustleaf_route=privy-admin-review-actor"
    },
    {
      "source": "/paciente",
      "destination": "/index.html"
    },
    {
      "source": "/paciente/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/medico",
      "destination": "/index.html"
    },
    {
      "source": "/medico/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dispensario",
      "destination": "/index.html"
    },
    {
      "source": "/dispensario/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/mvp",
      "destination": "/index.html"
    },
    {
      "source": "/mvp/:path*",
      "destination": "/index.html"
    }
  ]
}
